# ============================================================
# seefix-worker - example configuration
# Copy to .env and fill in. Never commit .env.
# Names and defaults match seefix-api, so you can reuse those values.
# ============================================================

# --- Jobs (each opt-in; enable only what this machine should run) ---
# OutboxEvents (Transport=PUSHER) -> Pusher private channels.
JOB_REALTIME_DISPATCH=on
# FAILED Agent work (report assessment, completion check) -> back to PENDING, with backoff and an attempt cap.
# The Agent picks PENDING work up itself; this job never calls the Agent.
JOB_AGENT_RETRY=on
# Direct-to-Cloudinary uploads never attached to a report/work order/document -> deleted after a minimum age.
# Needs the CLOUDINARY_* settings below.
JOB_UPLOAD_CLEANUP=off

# --- Database: the SAME database seefix-api and seefix-agents use ---
# Neon example: postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/seefixdb?sslmode=verify-full
DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5432/seefixdb
DATABASE_SSLMODE=prefer
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_POOL_MAX=2

# --- Pusher (same app as seefix-api) ---
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Cloudinary (same account as seefix-api; only for JOB_UPLOAD_CLEANUP) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- realtime-dispatch tuning (defaults match seefix-api) ---
OUTBOX_POLL_MS=2000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8
# Lease must exceed BATCH_SIZE x PUBLISH_TIMEOUT_MS (checked at startup).
OUTBOX_LEASE_SECONDS=60
OUTBOX_BACKOFF_BASE_MS=2000
OUTBOX_BACKOFF_MAX_MS=600000
OUTBOX_PUBLISH_TIMEOUT_MS=5000
# Never deliver rows older than this (stale realtime is noise; clients re-read REST).
OUTBOX_MAX_AGE_MINUTES=60

# --- agent-retry tuning ---
# How often to look for FAILED work.
AGENT_RETRY_INTERVAL_MS=60000
# Total attempts including the first one; after that the work stays FAILED for a human.
AGENT_RETRY_MAX_ATTEMPTS=3
# Wait after a failure before retrying: BASE x 2^(attempt-1) minutes (2, 4, 8 ...).
AGENT_RETRY_BASE_MINUTES=2

# --- upload-cleanup tuning ---
# How often to look for unattached uploads (default hourly).
UPLOAD_CLEANUP_INTERVAL_MS=3600000
# Only uploads at least this old are deleted (minimum 2; uploads are normally attached within minutes).
UPLOAD_CLEANUP_MIN_AGE_HOURS=24
